# Chuỗi kết nối MongoDB. Để trống khi phát triển = tự chạy MongoDB trên máy
MONGODB_URI=
# Chuỗi ngẫu nhiên dài, bắt buộc khi production
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Địa chỉ web khách hàng, dùng cho link trong email
CLIENT_URL=http://localhost:5173
# Gmail + mật khẩu ứng dụng. Để trống = email được in ra console
EMAIL_USER=
EMAIL_PASS=
# Tài khoản quản trị, chỉ đặt ở đây (bắt buộc khi production, mật khẩu ít nhất 8 ký tự)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Mật khẩu các tài khoản khách hàng mẫu (áp dụng khi chạy npm run seed)
DEMO_PASSWORD=
# Tiền đặt cọc online cho mỗi xe (VND)
DEPOSIT_PER_CAR=10000000
# Mã merchant VNPay (đăng ký tại https://sandbox.vnpayment.vn/devreg/). Để trống = trang thanh toán thử nghiệm
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

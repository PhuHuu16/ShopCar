# MongoDB connection string. Empty in development = built-in local MongoDB.
MONGODB_URI=
# Long random string, required in production
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Customer website address, used in email links
CLIENT_URL=http://localhost:5173
# Gmail + app password. Empty = emails are printed in the console
EMAIL_USER=
EMAIL_PASS=
# Admin login, only in this file (required in production, at least 8 characters).
# The account is updated to match every time the server starts.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Password of the demo customer accounts made by `npm run seed`
DEMO_PASSWORD=
# Online deposit per car (VND)
DEPOSIT_PER_CAR=10000000
# VNPay merchant from https://sandbox.vnpayment.vn/devreg/ . Empty = built-in demo payment page
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
